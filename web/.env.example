# ──────────────────────────────────────────────────────────────────────────────
# Web Frontend Environment Variables
# Copy this file to .env and fill in the values after deploying the contracts.
# All variables must be prefixed with VITE_ to be exposed to the browser bundle.
# ──────────────────────────────────────────────────────────────────────────────

# Deployed address of CS218Token on Sepolia
VITE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Deployed address of StakingContract on Sepolia
VITE_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
